{
  "name": "lab-management-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:smoke": "playwright test auth.spec.js all_pages.spec.js student.spec.js",
    "test:admin": "playwright test admin.spec.js",
    "test:faculty": "playwright test faculty.spec.js",
    "test:assistant": "playwright test assistant.spec.js",
    "test:ai": "playwright test ai_features.spec.js",
    "test:profile": "playwright test profile.spec.js",
    "test:load": "playwright test load_concurrent.spec.js --project=concurrent-users",
    "test:responsive": "playwright test responsive.spec.js",
    "test:headed": "playwright test --headed --workers=1",
    "test:report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "clsx": "^2.1.0",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.3",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6"
  }
}
